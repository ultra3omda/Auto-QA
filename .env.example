# ─── Supabase (PostgreSQL backend) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ─── Anthropic (Claude — agent + vision QA) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Spec d'origine : claude-3-5-sonnet. Default modernisé vers Sonnet 4.6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Browserbase (cloud browser + résidentiel proxy + captcha) ───────
BROWSERBASE_API_KEY=bb_xxxxx
BROWSERBASE_PROJECT_ID=prj_xxxxx

# ─── IMAP catch-all (clubprivileges.app) ─────────────────────────────
IMAP_SERVER=mail.clubprivileges.app
IMAP_USER=assistant@clubprivileges.app
IMAP_PASSWORD=changeme

# ─── Carte bancaire virtuelle (Revolut, plafond 1$) ──────────────────
QA_CC_NUMBER=0000000000000000
QA_CC_EXP_MONTH=05
QA_CC_EXP_YEAR=31
QA_CC_CVC=000

# ─── Cron knobs ──────────────────────────────────────────────────────
CRON_BATCH_SIZE=20
CRON_CONCURRENCY=1
AGENT_MAX_STEPS=30
LOG_LEVEL=INFO
